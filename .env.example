# Names and descriptions only. Never commit values.

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=us-central1
FIRESTORE_DATABASE_ID=
GCS_UPLOAD_BUCKET=
GCS_REPORT_BUCKET=

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Vertex AI Gemini (regional endpoint)
VERTEX_LOCATION=us-central1
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=

# Parallel Search (runtime requirement)
PARALLEL_API_KEY=

# Grafana Cloud MCP
GRAFANA_MCP_URL=
GRAFANA_MCP_TOKEN=

# Queue
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_COORDINATOR_URL=

# Policy
RUN_COST_CAP_USD=1.00
RUN_PARALLEL_CALL_CAP=50
ENTITY_PARALLEL_CALL_CAP=3
RUN_ENTITY_CAP=50
RUN_DEADLINE_SECONDS=600
USER_DAILY_RUN_LIMIT=3
GLOBAL_DAILY_RUN_LIMIT=25
MAX_CONCURRENT_RUNS=1
AGGREGATE_PREDEMO_CAP_USD=80

# Kill switches
GEMINI_ENABLED=true
PARALLEL_ENABLED=true
GRAFANA_MCP_ENABLED=true

# Platform admin allowlist (comma-separated Google accounts)
PLATFORM_ADMIN_ALLOWLIST=
